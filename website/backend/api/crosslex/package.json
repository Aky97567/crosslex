{
  "name": "@whitelotus/back-api-crosslex",
  "description": "Crosslex NestJS API",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "db": "docker compose up -d",
    "down": "docker compose down",
    "wipe": "docker volume rm crosslex_crosslex-pg-data",
    "dev": "nest start --watch",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:test-db": "DATABASE_URL=\"postgresql://crosslex:crosslex@localhost:5432/crosslex?schema=test\" prisma migrate deploy",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "jest --selectProjects unit",
    "test:e2e": "yarn migrate:test-db && jest --selectProjects e2e",
    "test:ci": "yarn migrate:test-db && jest --ci --coverage"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@nestjs/apollo": "^13.1.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/graphql": "^13.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "graphql": "^16.11.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30",
    "@types/ms": "^2.1.0",
    "@types/node": "^22",
    "@types/passport": "^0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11"
  }
}
