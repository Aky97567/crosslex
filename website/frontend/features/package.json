{
  "name": "@whitelotus/front-features",
  "private": true,
  "version": "0.0.1",
  "main": "src/index",
  "description": "Exports feature modules to be used in the construction of pages and process for the Crosslex site",
  "scripts": {
    "check:precommit": "lint-staged",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:update": "jest --updateSnapshot",
    "lint": "yarn lint:js && yarn lint:css",
    "lint:js": "eslint src test",
    "lint:css": "stylelint \"src/**/*.styles.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11"
  }
}
