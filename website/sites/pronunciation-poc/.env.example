# Copy this file to .env.local and fill in your own ElevenLabs API key.
# Get one at https://elevenlabs.io/app/settings/api-keys
#
# .env.local is gitignored — never commit a real key.

ELEVENLABS_API_KEY=

# Optional — defaults to "Rachel" (21m00Tcm4TlvDq8ikWAM), a stable premade
# multilingual voice. Swap in any voice ID from your ElevenLabs account.
ELEVENLABS_VOICE_ID=
